<?xml version="1.0" encoding="UTF-8"?>
<automata>
    <alfabeto>
        <simbolo>a</simbolo>
        <simbolo>b</simbolo>
    </alfabeto>

    <estados>
        <estado id="q0" inicial="true" final="false" />
        <estado id="q1" inicial="false" final="false" />
        <estado id="q2" inicial="false" final="false" />
        <estado id="q3" inicial="false" final="true" />
        <estado id="q4" inicial="false" final="true" />
        <estado id="q5" inicial="false" final="false" />
        <estado id="q6" inicial="false" final="true" />
        <estado id="q7" inicial="false" final="false" />
    </estados>

    <transiciones>
        <!-- Estado inicial q0 -->
        <transicion origen="q0" simbolo="a"><destino>q1</destino></transicion>
        <transicion origen="q0" simbolo="b"><destino>q5</destino></transicion>

        <!-- q1 y q5 son totalmente equivalentes -->
        <transicion origen="q1" simbolo="a"><destino>q2</destino></transicion>
        <transicion origen="q1" simbolo="b"><destino>q3</destino></transicion>

        <transicion origen="q5" simbolo="a"><destino>q2</destino></transicion>
        <transicion origen="q5" simbolo="b"><destino>q3</destino></transicion>

        <!-- q2 lleva a estados finales -->
        <transicion origen="q2" simbolo="a"><destino>q3</destino></transicion>
        <transicion origen="q2" simbolo="b"><destino>q4</destino></transicion>

        <!-- q3 y q4 son estados finales equivalentes -->
        <transicion origen="q3" simbolo="a"><destino>q3</destino></transicion>
        <transicion origen="q3" simbolo="b"><destino>q6</destino></transicion>

        <transicion origen="q4" simbolo="a"><destino>q4</destino></transicion>
        <transicion origen="q4" simbolo="b"><destino>q6</destino></transicion>

        <!-- q6 es final y mantiene el patron -->
        <transicion origen="q6" simbolo="a"><destino>q3</destino></transicion>
        <transicion origen="q6" simbolo="b"><destino>q4</destino></transicion>

        <!-- q7 es un estado equivalente a q2 -->
        <transicion origen="q7" simbolo="a"><destino>q4</destino></transicion>
        <transicion origen="q7" simbolo="b"><destino>q3</destino></transicion>
    </transiciones>
</automata>